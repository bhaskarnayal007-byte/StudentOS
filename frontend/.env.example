# Supabase -> Project Settings -> Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / publishable.
# This is the PUBLIC key and ships to the browser. Never put the service_role
# key here — that one belongs only in the backend's .env.
VITE_SUPABASE_ANON_KEY=

# Where student-os-backend is running.
VITE_API_URL=http://localhost:3001

# Optional: shows "Connect Google Calendar" on the Calendar page (read-only).
# Google Cloud console → enable "Google Calendar API" → Credentials → OAuth
# client ID (Web application) → Authorized JavaScript origins: your dev URL
# (http://localhost:5173) and production URL. On the OAuth consent screen add
# the calendar.readonly scope, and add yourself under Test users. Leave blank
# to hide the button.
VITE_GOOGLE_CLIENT_ID=
