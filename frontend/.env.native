# Loaded on top of .env by `npm run build:native` (vite --mode native).
# The app shell has no dev server next to it, so it always talks to the
# deployed backend. Public URL, not a secret.
VITE_API_URL=https://stratus-api.bhaskarnayal007.workers.dev

# Where the website is deployed (no trailing slash). The app checks
# <this>/native/manifest.json for live updates; blank turns them off.
VITE_UPDATE_URL=https://stratus-ae5.pages.dev
