# Supabase project settings -> Data API  (the URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase project settings -> API Keys -> service_role (SECRET).
# This key bypasses Row Level Security. Server only. Never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Key for the AI provider. Server only.
AI_API_KEY=

# Fallback for a single provider, used only when AI_PROVIDERS is empty.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# The rotation: `name|baseUrl|model|KEY_ENV_VAR` entries, comma-separated,
# tried in order. Free tiers are metered PER MODEL, so each entry is its own
# pool -- three Groq models on one key is 600k tokens/day instead of 200k.
# Entries whose key env var is unset are skipped, so this list can name
# providers you have not signed up for yet. Order by headroom, roomiest first.
AI_PROVIDERS=groq|https://api.groq.com/openai/v1|openai/gpt-oss-120b|AI_API_KEY,groq|https://api.groq.com/openai/v1|openai/gpt-oss-20b|AI_API_KEY,groq|https://api.groq.com/openai/v1|qwen/qwen3.8-27b|AI_API_KEY

# Optional extra pools. NVIDIA NIM gives 10,000 requests/day per model and
# belongs at the FRONT of AI_PROVIDERS once you have a key:
#   nvidia|https://integrate.api.nvidia.com/v1|openai/gpt-oss-20b|NVIDIA_API_KEY
NVIDIA_API_KEY=
#   openrouter|https://openrouter.ai/api/v1|<model>:free|OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Origin(s) allowed to call this API. Comma-separated.
FRONTEND_URL=http://localhost:5173

# Optional. Comma-separated emails allowed to use the AI route.
# Supabase sign-up is open by default, so without this anyone who finds the
# deployed URL can register and spend your AI quota. Leave empty for local dev.
ALLOWED_EMAILS=

# Optional. Total daily token quota across every model in AI_PROVIDERS
# (default 600000 = three Groq models at 200k each). Split evenly between
# users active in the last 7 days, recounted every 10 minutes. Raise it by
# 200000 for each Groq model you add to the rotation.
AI_DAILY_TOKENS=

# Table the /api/data routes read and write.
DATA_TABLE=items

PORT=3001
