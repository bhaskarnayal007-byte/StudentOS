{
  "name": "stratus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker for Stratus: verifies Supabase session tokens and proxies AI calls so the provider keys never reach the app.",
  "author": "Bhaskar Nayal",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --env-file=.env scripts/check-env.mjs",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "test": "node scripts/test-worker.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
