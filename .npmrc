# @react-three/fiber declares OPTIONAL Expo peers (expo, expo-asset,
# expo-file-system) for its React Native consumers. Installed standalone npm
# ignores them, but at a workspace root it tries to resolve that graph and
# expo@57 drags in a conflicting peer tree.
#
# This app is web-only and never imports Expo, so relax peer resolution rather
# than installing React Native. Committed on purpose: a clone must install the
# same way without anyone remembering a flag.
legacy-peer-deps=true