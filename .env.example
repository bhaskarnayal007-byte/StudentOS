# Supabase project settings -> Data API  (the URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase project settings -> API Keys -> service_role (SECRET).
# This key bypasses Row Level Security. Server only. Never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Key for the AI provider. Server only.
AI_API_KEY=

# Any OpenAI-compatible base URL. Groq shown; swap for another provider as-is.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Origin(s) allowed to call this API. Comma-separated.
FRONTEND_URL=http://localhost:5173

# Optional. Comma-separated emails allowed to use the AI route.
# Supabase sign-up is open by default, so without this anyone who finds the
# deployed URL can register and spend your AI quota. Leave empty for local dev.
ALLOWED_EMAILS=

# Table the /api/data routes read and write.
DATA_TABLE=items

PORT=3001
